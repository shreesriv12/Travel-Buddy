generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password_hash  String
  name           String
  avatar_url     String?
  theme_preference String?
  google_token   String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  trips          Trip[]
  notifications  Notification[]
  trip_comparisons TripComparison[]
}

model Trip {
  id              String          @id @default(uuid())
  user_id         String
  title           String
  origin          String           @default("Unknown")   // default value
  origin_coords   Json             @default("{}")        // empty JSON
  destination     String
  destination_coords Json
  start_date      DateTime
  end_date        DateTime
  adults          Int             @default(1)           // default 1 adult
  status          String
  total_budget    Float
  summary         Json
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  user            User            @relation(fields: [user_id], references: [id])
  itinerary_items ItineraryItem[]
  weather_data    WeatherData[]
  routes          Route[]
  events          Event[]
  budget_items    BudgetItem[]
  agent_tasks     AgentTask[]
  notifications   Notification[]
}


model ItineraryItem {
  id             String   @id @default(uuid())
  trip_id        String
  day_number     Int
  title          String
  description    String
  start_time     DateTime
  end_time       DateTime
  location       String
  location_coords Json
  category       String
  estimated_cost Float
  sort_order     Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  trip           Trip     @relation(fields: [trip_id], references: [id])
}

model WeatherData {
  id              String   @id @default(uuid())
  trip_id         String
  location        String
  date            DateTime
  temperature_high Float
  temperature_low  Float
  conditions      String
  precipitation   Float
  weather_json    Json
  fetched_at      DateTime @default(now())

  trip            Trip     @relation(fields: [trip_id], references: [id])
}

model Route {
  id              String   @id @default(uuid())
  trip_id         String
  from_location   String
  to_location     String
  transport_mode  String
  distance_km     Float
  duration_minutes Int
  estimated_cost  Float
  route_data      Json
  created_at      DateTime @default(now())

  trip            Trip     @relation(fields: [trip_id], references: [id])
}

model Event {
  id             String   @id @default(uuid())
  trip_id        String
  title          String
  description    String
  location       String
  start_datetime DateTime
  end_datetime   DateTime
  category       String
  price          Float
  booking_url    String?
  is_recommended Boolean
  relevance_score Float
  created_at     DateTime @default(now())

  trip           Trip     @relation(fields: [trip_id], references: [id])
}

model BudgetItem {
  id              String   @id @default(uuid())
  trip_id         String
  category        String
  item_name       String
  estimated_amount Float
  actual_amount    Float
  status          String
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  trip            Trip     @relation(fields: [trip_id], references: [id])
}

model AgentTask {
  id             String   @id @default(uuid())
  trip_id        String
  agent_type     String
  task_data      Json
  result_data    Json?
  status         String
  started_at     DateTime?
  completed_at   DateTime?
  error_message  String?

  trip           Trip     @relation(fields: [trip_id], references: [id])
}

model Notification {
  id             String   @id @default(uuid())
  user_id        String
  trip_id        String?
  type           String
  title          String
  message        String
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])
  trip           Trip?    @relation(fields: [trip_id], references: [id])
}

model TripComparison {
  id             String   @id @default(uuid())
  user_id        String
  comparison_name String
  destinations   Json
  criteria       Json
  results        Json
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])
}
